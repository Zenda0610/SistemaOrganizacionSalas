# Copie este archivo como .env y complete los valores. No suba .env al repositorio.

# Base de datos y datos de carga (vacío = valor por defecto de app/config.py)
RUTA_BASE_DATOS=
RUTA_DATOS=

# Bloques de tiempo (operación 24/7)
MINUTOS_BLOQUE=

# Cliente de IA: IA_PROVEEDOR = ollama | openai (API compatible con OpenAI)
IA_PROVEEDOR=openai
IA_URL=https://openrouter.ai/api/v1
IA_MODELO=nvidia/nemotron-3.5-super-vl:free
# Pegue la clave SOLO en .env (backend). No se requiere clave para leer esta plantilla.
IA_API_KEY=PEGA_AQUI_TU_CLAVE
IA_TIMEOUT_SEGUNDOS=60

# Identidad de desarrollo (NO es autenticación). Vacío = sin identidad: las acciones protegidas responden 401.
# ROL_DESARROLLO: profesor | administrativo | estudiante | empresa | coordinadora
USUARIO_DESARROLLO=dev-profesor
ROL_DESARROLLO=profesor
